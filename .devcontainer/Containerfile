FROM registry.fedoraproject.org/fedora:43

ARG TASK_VERSION=3.45.4
ARG KIND_VERSION=0.32.0
ARG KUBECTL_VERSION=1.35.0

RUN dnf install -y \
        bash \
        ca-certificates \
        curl \
        findutils \
        git \
        podman \
        procps-ng \
        tar \
    && dnf clean all

# Task
RUN curl --fail --location --silent --show-error \
        "https://github.com/go-task/task/releases/download/v${TASK_VERSION}/task_linux_amd64.tar.gz" \
        --output /tmp/task.tar.gz \
    && tar --extract \
        --gzip \
        --file /tmp/task.tar.gz \
        --directory /usr/local/bin \
        task \
    && rm /tmp/task.tar.gz \
    && task --version

# kind
RUN curl --fail --location --silent --show-error \
        "https://kind.sigs.k8s.io/dl/v${KIND_VERSION}/kind-linux-amd64" \
        --output /usr/local/bin/kind \
    && chmod +x /usr/local/bin/kind \
    && kind version

# kubectl
RUN curl --fail --location --silent --show-error \
        "https://dl.k8s.io/release/v${KUBECTL_VERSION}/bin/linux/amd64/kubectl" \
        --output /usr/local/bin/kubectl \
    && chmod +x /usr/local/bin/kubectl \
    && kubectl version --client

WORKDIR /workspace
